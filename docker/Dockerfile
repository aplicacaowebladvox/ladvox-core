FROM eclipse-temurin:21-jdk-alpine

ARG PROFILE
ARG DB_NAME
ARG DB_USERNAME
ARG DB_PASSWORD
ARG DB_URL

ENV SPRING_PROFILES_ACTIVE=$PROFILE
ENV DB_NAME=$DB_NAME
ENV DB_USERNAME=$DB_USERNAME
ENV DB_PASSWORD=$DB_PASSWORD
ENV DB_URL=$DB_URL

EXPOSE 8080
ADD /projeto-fono-*.jar projeto-fono.jar
ENTRYPOINT ["java", "-jar", "projeto-fono.jar"]
